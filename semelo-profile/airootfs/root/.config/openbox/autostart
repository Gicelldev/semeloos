#!/bin/bash
# SemeloOS - Openbox Autostart
# Runs when Openbox starts, launches Chromium as native full browser

# Set wallpaper to solid dark color
xsetroot -solid "#0d0d0f"

# Wait for compositor to initialize
sleep 0.5

# Launch Chromium in native mode (full browser with tabs, address bar, etc.)
# --no-sandbox required when running as root
chromium \
    --no-sandbox \
    --no-first-run \
    --no-default-browser-check \
    --disable-sync \
    --disable-background-networking \
    --disable-breakpad \
    --disable-dev-shm-usage \
    --no-pings \
    --password-store=basic \
    --start-maximized &
